# Keep the build context small and free of local/workspace state and secrets.
.git/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
tests/
.claude/

# Local workspace + vector state (must never be baked into the image)
*.db
lancedb/
browser_profile/
.session
config.yaml
config.yaml.migrated
briefs/
exports/
repos/
evals/

# Frontend build state (the image builds the UI itself in its node stage)
frontend/node_modules/
frontend/dist/

# Env / secrets
.env

# Docs/artifacts not needed at runtime
*.md
!README.md
