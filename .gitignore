__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.env
.pytest_cache/
.coverage
.claude/settings.local.json
*.db
lancedb/
debugging/

# Local workspace state — never commit. If someone runs qj with the repo as its
# workspace (or QJ_WORKSPACE points inside it), these appear here:
#   browser_profile/  Playwright/Chromium profile: live SSO cookies, tokens, and
#                     saved logins after `qj browser login`, plus machine-specific
#                     caches. Nothing in a browser profile belongs in a shared repo
#                     — the session files are credentials, the rest is disposable
#                     cache. Each user runs `qj browser login` on their own machine.
#   .session          the CLI's bearer token (a live credential)
#   /config.yaml      a real workspace config may hold literal secrets
#                     (config.example.yaml is the tracked template)
browser_profile/
.session
/config.yaml
briefs/
exports/
repos/
evals/
# The unanchored `evals/` rule above (meant for a workspace's generated
# <workspace>/evals/*.json reports) also matched docs/evals/ — the checked-in,
# hand-authored eval sets (found 2026-07-29: docs/evals/multi-hop-crosssource.yaml
# had silently never been committed since the initial commit). Un-ignore it explicitly.
!docs/evals/
!docs/evals/**

# Claude Code's relocated per-user data dir (session history, memory,
# settings, credentials, plugins) — see scripts/relocate-claude-config.ps1.
# This holds real credentials; it must never be committed.
.claude-home/

# Toolchains scripts/activate.ps1 provisions for a machine that lacks them
# (currently a repo-local Node when there's no usable one and no nvm).
# Large, platform-specific binaries — re-fetched on demand, never committed.
.tools/
