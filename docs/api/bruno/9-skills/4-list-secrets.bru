meta {
  name: List my secret names
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/skills/secrets
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Which names this caller has set (`mine`) and which are set workspace-wide (`workspace`).

  Presence, never content — there is no endpoint anywhere that reads a stored value back out.
  A personal value of the same name overrides the workspace one.
}
