meta {
  name: Remove one of my secrets
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/skills/secrets/{{skillSecretKey}}?scope=user
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  scope: user
}

docs {
  Remove a stored credential. `scope=user` (default) removes yours; `scope=workspace` removes
  the shared one and needs the admin tier.
}
