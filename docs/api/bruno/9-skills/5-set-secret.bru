meta {
  name: Set one of my secrets
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/skills/secrets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "key": "{{skillSecretKey}}",
    "value": "paste-the-real-value-here",
    "scope": "user"
  }
}

docs {
  Store one credential, encrypted at rest, for the skills that require it.

  `scope: "user"` (the default) is yours alone and overrides a workspace value of the same
  name — every signed-in user may do this, since it is their own credential and reaches
  nobody else's.

  `scope: "workspace"` is an admin's shared default (an endpoint URL, a tenant id) that
  everyone inherits, and needs the admin tier (403 otherwise).
}
