meta {
  name: Create first user (turns auth ON)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

docs {
  Creates a user. The FIRST user turns authentication ON for the whole workspace — everything
  is open until then. Run once, then use Login.
}
