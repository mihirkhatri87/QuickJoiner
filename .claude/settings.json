{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(.venv/Scripts/qj.exe *)",
      "Bash(.venv/Scripts/python.exe -m pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
